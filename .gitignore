# Only frontend/ and backend/ are tracked in this repo
/*
!/frontend/
!/backend/
!/linux/
!/.gitignore

# frontend
frontend/node_modules/
frontend/.expo/
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts
frontend/.kotlin/
frontend/*.orig.*
frontend/*.jks
frontend/*.p8
frontend/*.p12
frontend/*.key
frontend/*.mobileprovision
frontend/.metro-health-check*
frontend/npm-debug.*
frontend/yarn-debug.*
frontend/yarn-error.*
frontend/.DS_Store
frontend/*.pem
frontend/.env*.local
frontend/*.tsbuildinfo
frontend/example
frontend/ios/
frontend/android/
frontend/.claude/
frontend/.vscode/

# backend
backend/HELP.md
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/.apt_generated
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings
backend/.springBeans
backend/.sts4-cache
backend/.idea/
backend/*.iws
backend/*.iml
backend/*.ipr
backend/nbproject/private/
backend/nbbuild/
backend/dist/
backend/nbdist/
backend/.nb-gradle/
backend/build/
backend/.vscode/
